#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"

require_relative "../lib/wrangle"

# A CLI built for someone deciding what to do next — a person at a prompt or an agent in a shell.
#
# Each command is its own process, so the session lives in a background server and every command
# talks to it. Failures are named, exit codes are distinct, and an action always reports what moved.
module Wrangle
  module CLI
    OK = 0
    USAGE = 2
    STALE = 3        # look again and retry
    TERMINAL = 4     # the session is over
    UNAVAILABLE = 5  # no session, or the bridge failed

    USAGE_TEXT = <<~TEXT
      wrangle - hand one Safari window to a program, and no more than that

      One-shot:
        wrangle windows [--titles]        list Safari windows
        wrangle windows --app APP         list scoped macOS window ids without titles
        wrangle displays [--driver macos] list displays in top-left window coordinates
        wrangle doctor                    check macOS driver capabilities and permissions
        wrangle task --app APP --goal GOAL
                                          complete one bounded native desktop task
        wrangle qualify --provider NAME   run the provider conformance suite and emit a receipt
                         [--suite PATH] [--output PATH]

      Decide with Jev (needs JEV_API_KEY):
        wrangle decide --goal "..."        propose one action; changes nothing
        wrangle run --goal "..." --execute act on its own, bounded by --steps

      Interactive session (survives between commands):
        wrangle open <url> [--display N]  open a window Wrangle owns
                          [--side left]   park it on half a display
                          [--backend mcp] drive safaridriver's own tab instead of Apple Events
        wrangle attach <window_id>        take over a Safari window you already have open
        wrangle attach --app APP <w-id>   scope one macOS application window
                       [--frontmost 3]     take the front window after a countdown
                       [--pick]            choose one listed application window
                       [--cooperative]     permit another session on the same root
        wrangle observe [--match RE]      look; lists numbered actions
        wrangle drill <ref>               expand one observed progressive branch
        wrangle inspect                   pull the full latest machine observation
        wrangle preview <ref> [--operation OP] [--text STR]
                                          bind an action to the current revision
        wrangle preview --goal GOAL [--literal NAME=VALUE]
                                          let the explicit provider propose an action
        wrangle execute <proposal_id> [--approve]
                                          revalidate and dispatch the proposal once
        wrangle continue <run_id>         continue authorized safe actions within budget
        wrangle act <ref> [--text STR]    do one Safari action, and report what changed
        wrangle text [--match RE]         print the page text
        wrangle status
        wrangle stop                     emergency-stop without application focus
        wrangle close                    release control; attached app windows stay open

      Common options: --session NAME (default "default"), --json, --all, --settle SECONDS

      wrangle --version | wrangle --help

      Exit codes: 0 ok, 2 usage, 3 stale (observe and retry), 4 session over, 5 unavailable.
    TEXT

    module_function

    def run(argv)
      command = argv.shift
      options = parse(argv)
      case command
      when "windows" then windows(options)
      when "displays" then displays(options)
      when "doctor", "qualify", "task" then public_send(command, options)
      when "open" then start({ "url" => argv.first }, options)
      when "attach" then attach(argv.first, options)
      when "observe" then observe(options)
      when "drill" then drill(argv.first, options)
      when "inspect" then inspect(options)
      when "preview" then preview(argv.first, options)
      when "execute" then execute(argv.first, options)
      when "continue" then continue_run(argv.first, options)
      when "act" then act(argv.first, options)
      when "text" then text(options)
      when "decide" then propose(argv, options, execute: false)
      when "run" then propose(argv, options, execute: true)
      when "status" then status(options)
      when "stop" then stop(options)
      when "close" then close(options)
      when "__serve" then serve(argv)
      when "__serve_macos" then serve_macos(argv)
      when nil, "help", "-h", "--help" then puts(USAGE_TEXT) || OK
      when "version", "-v", "--version" then puts(Wrangle::VERSION) || OK
      else warn("unknown command: #{command}\n\n#{USAGE_TEXT}") || USAGE
      end
    rescue Wrangle::Error => e
      warn "#{e.class.name.split("::").last}: #{e.message}"
      UNAVAILABLE
    end

    def parse(argv)
      options = { session: "default", settle: nil, json: false, all: false, match: nil }
      parser = OptionParser.new
      scope_options(parser, options)
      run_options(parser, options)
      parser.parse!(argv)
      options
    end

    def scope_options(parser, options)
      parser.on("--session NAME") { |v| options[:session] = v }
      parser.on("--display N", Integer) { |v| options[:display] = v }
      parser.on("--side SIDE") { |v| options[:side] = v }
      parser.on("--backend NAME") { |v| options[:backend] = v }
      parser.on("--driver NAME") { |v| options[:driver] = v }
      parser.on("--app APP") { |v| options[:app] = v }
      parser.on("--frontmost [SECONDS]", Float) { |v| options[:frontmost] = v || 3.0 }
      parser.on("--pick") { options[:pick] = true }
      parser.on("--cooperative") { options[:cooperative] = true }
      parser.on("--provider NAME") { |v| options[:provider] = v }
      parser.on("--provider-model NAME") { |v| options[:provider_model] = v }
      parser.on("--provider-endpoint URL") { |v| options[:provider_endpoint] = v }
      parser.on("--provider-trace PATH") { |v| options[:provider_trace] = v }
      parser.on("--provider-qualification PATH") { |v| options[:provider_qualification] = v }
      parser.on("--provider-max-choices N", Integer) { |v| options[:provider_max_choices] = v }
      parser.on("--titles") { options[:titles] = true }
      parser.on("--all") { options[:all] = true }
      parser.on("--json") { options[:json] = true }
    end

    def run_options(parser, options)
      parser.on("--steady MS", Float) { |v| options[:steady] = v / 1000.0 }
      parser.on("--plan GOAL") { |v| (options[:plan] ||= []) << v }
      parser.on("--leg-steps N", Integer) { |v| options[:leg_steps] = v }
      parser.on("--text STR") { |v| options[:text] = v }
      parser.on("--operation OP") { |v| options[:operation] = v }
      parser.on("--approve") { options[:approve] = true }
      parser.on("--match RE") { |v| options[:match] = v }
      parser.on("--settle S", Float) { |v| options[:settle] = v }
      parser.on("--goal STR") { |v| options[:goal] = v }
      parser.on("--literal PAIR") { |v| (options[:literals] ||= {}).store(*v.split("=", 2)) }
      parser.on("--steps N", Integer) { |v| options[:steps] = v }
      parser.on("--min-confidence F", Float) { |v| options[:min_confidence] = v }
      parser.on("--execute") { options[:execute] = true }
      parser.on("--expect RE") { |v| options[:expect] = v }
      parser.on("--suite PATH") { |v| options[:suite] = v }
      parser.on("--output PATH") { |v| options[:output] = v }
    end

    def client(options) = SessionClient.new(SessionServer.socket_path(options[:session]))

    # --- one-shot ------------------------------------------------------------------------------

    def windows(options)
      return macos_windows(options) if options[:app]

      listed = Wrangle::Safari.windows(titles: options[:titles])
      return emit(listed) if options[:json]

      listed.each do |window|
        line = format("%8d  display %-4s %d tab%s", window["window_id"], window["display"] || "?",
                      window["tabs"], window["tabs"] == 1 ? "" : "s")
        line += "  #{window["title"]}" if options[:titles]
        puts line
      end
      OK
    end

    def macos_windows(options)
      listed = Wrangle::MacOSHelper.new.windows(app: options[:app], titles: options[:titles])
      return emit(listed) if options[:json]

      listed.each do |window|
        bounds = window.fetch("bounds")
        mark = window["focused"] ? "front" : ""
        line = format("%-12s %-18s %5d,%5d %4dx%-4d %s", window["id"], window["app_name"],
                      bounds["x"], bounds["y"], bounds["width"], bounds["height"], mark)
        line += "  #{window["title"]}" if options[:titles]
        puts line.rstrip
      end
      OK
    end

    def displays(options)
      listed = if options[:driver] == "macos"
                 Wrangle::MacOSHelper.new.displays.map { |display| display.fetch("bounds") }
               else
                 Wrangle::Safari.displays
               end
      return emit(listed) if options[:json]

      listed.each_with_index do |display, index|
        puts format("%d  x=%-7d y=%-7d %dx%d", index, display["x"], display["y"],
                    display["width"], display["height"])
      end
      OK
    end

    def doctor(options)
      driver = Wrangle::MacOSDriver.new
      report = driver.doctor
      return emit(report) if options[:json]

      puts "macOS           #{report["platform"] || "unavailable"}"
      puts "ready           #{report["ready"]}"
      if report["driver"]
        puts "driver          #{report["driver"]}"
        puts "display source  #{report.dig("capabilities", "display_inventory")}"
      else
        puts "error           #{report["error"]}"
      end
      report["ready"] ? OK : UNAVAILABLE
    ensure
      driver&.close
    end

    TASK_PROVIDER_ENV = {
      "provider_model" => "WRANGLE_DESKTOP_PROVIDER_MODEL",
      "provider_endpoint" => "WRANGLE_DESKTOP_PROVIDER_ENDPOINT",
      "provider_trace" => "WRANGLE_DESKTOP_PROVIDER_TRACE",
      "provider_qualification" => "WRANGLE_DESKTOP_PROVIDER_QUALIFICATION"
    }.freeze

    def task(options)
      return warn("task needs --app APP and --goal GOAL") || USAGE if
        options[:app].to_s.strip.empty? || options[:goal].to_s.strip.empty?

      value = DesktopTask.new.run(
        app: options[:app], goal: options[:goal], literals: options[:literals] || {},
        steps: options[:steps] || DesktopTask::DEFAULT_STEPS,
        min_confidence: options[:min_confidence] || 0.5,
        concurrency: options[:cooperative] ? "cooperative" : "exclusive",
        provider_options: task_provider_options(options)
      )
      return emit({ "ok" => true, "value" => value }) if options[:json]

      puts value.fetch("message")
      puts "status   #{value.fetch("status")}"
      puts "actions  #{value.fetch("actions_taken")}"
      OK
    rescue Wrangle::Error, ArgumentError => e
      task_failure(e, options)
    end

    def task_provider_options(options)
      values = PROVIDER_OPTIONS.to_h { |key| [key.to_s, options[key]] }.compact
      values["provider"] ||= ENV.fetch("WRANGLE_DESKTOP_PROVIDER", nil)
      if values["provider"].to_s.empty?
        raise ConfigurationError, "Set --provider or WRANGLE_DESKTOP_PROVIDER explicitly for desktop tasks"
      end

      TASK_PROVIDER_ENV.each do |key, environment|
        configured = ENV.fetch(environment, nil)
        values[key] ||= configured unless configured.to_s.empty?
      end
      values
    end

    def task_failure(error, options)
      reply = { "ok" => false, "class" => error.class.name.split("::").last, "error" => error.message,
                "terminal" => true, "retryable" => false }
      return emit(reply) if options[:json]

      warn "#{reply["class"]}: #{reply["error"]}"
      UNAVAILABLE
    end

    def qualify(options)
      return warn("qualify needs --provider replay or jev") || USAGE if options[:provider].to_s.empty?

      suite = options[:suite] || ProviderQualification::DEFAULT_SUITE
      provider_options = PROVIDER_OPTIONS.to_h { |key| [key.to_s, options[key]] }.compact
      provider_options["provider_trace"] ||= suite if options[:provider] == "replay"
      provider = ProviderFactory.build(provider_options)
      cases = ProviderQualification.load(suite)
      report = ProviderQualification.run(provider, cases)
      write_qualification(options[:output], report) if options[:output]
      return emit(report) if options[:json]

      puts "provider   #{report["provider"]}/#{report["model"]}"
      puts "suite      #{report["suite_sha256"]}"
      puts "passed     #{report["passed"]}/#{report["cases"]}"
      puts "qualified  #{report["qualified"]}"
      puts "receipt    #{options[:output]}" if options[:output]
      report["qualified"] ? OK : TERMINAL
    end

    def write_qualification(path, report)
      directory = File.dirname(File.expand_path(path))
      FileUtils.mkdir_p(directory, mode: 0o700)
      temporary = File.join(directory, ".#{File.basename(path)}.#{Process.pid}.tmp")
      File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write(JSON.pretty_generate(report))
        file.write("\n")
        file.flush
        file.fsync
      end
      File.rename(temporary, path)
    ensure
      FileUtils.rm_f(temporary) if defined?(temporary)
    end

    # --- session -------------------------------------------------------------------------------

    def attach(identifier, options)
      if options[:app] || options[:frontmost] || options[:pick]
        chosen = choose_macos_window(identifier, options)
        start({ "driver" => "macos", "window_id" => chosen["id"], "app" => chosen["app_name"] }, options)
      else
        start({ "window_id" => Integer(identifier, exception: false) }, options)
      end
    end

    def choose_macos_window(identifier, options)
      helper = Wrangle::MacOSHelper.new
      if options[:frontmost]
        warn "Select the window to hand over; capturing frontmost in #{options[:frontmost]}s"
        sleep options[:frontmost]
        chosen = helper.frontmost
        if options[:app] && chosen["app_name"].to_s.casecmp?(options[:app]) == false
          raise ScopeLost, "Frontmost window belongs to #{chosen["app_name"]}, not #{options[:app]}"
        end

        return chosen
      end
      return pick_macos_window(helper, options[:app]) if options[:pick]
      raise ArgumentError, "macOS attach needs --app" unless options[:app]

      { "id" => identifier, "app_name" => options[:app] }
    end

    def pick_macos_window(helper, app)
      raise ArgumentError, "--pick requires --app" if app.to_s.empty?

      windows = helper.windows(app:, titles: true)
      raise ScopeLost, "No visible #{app} windows" if windows.empty?

      windows.each_with_index do |window, index|
        bounds = window.fetch("bounds")
        puts format("%2d  %-12s %5d,%5d %4dx%-4d %s", index + 1, window["id"], bounds["x"], bounds["y"],
                    bounds["width"], bounds["height"], window["title"].to_s[0, 60])
      end
      print "Window: "
      selected = Integer($stdin.gets, exception: false)
      unless selected&.between?(1, windows.length)
        raise ArgumentError, "Choose a window number from 1 to #{windows.length}"
      end

      windows[selected - 1]
    end

    def start(target, options)
      required = target["driver"] == "macos" ? target.values_at("window_id", "app") : [target.values.first]
      return warn("open needs a url; attach needs a window id and --app for macOS") || USAGE if required.any?(&:nil?)

      socket = SessionServer.socket_path(options[:session])
      return warn("A session named #{options[:session].inspect} is already running.") || USAGE if
        SessionClient.new(socket).running?

      return spawn_desktop(socket, target, options) if target["driver"] == "macos"

      backend = (options[:backend] || "jxa").to_s
      unless %w[jxa mcp].include?(backend)
        return warn("Unknown backend #{backend.inspect}. Choose jxa (Apple Events) or mcp (safaridriver).") || USAGE
      end

      bounds = options[:side] && side_bounds(options[:display], options[:side])
      return USAGE if options[:side] && bounds.nil?

      # A display index and explicit bounds are mutually exclusive downstream, and --side has already
      # resolved the display into a rectangle, so send one or the other and never both.
      spawn_server(socket, target.merge("display" => (bounds ? nil : options[:display]),
                                        "bounds" => bounds, "backend" => backend))
      observe(options)
    end

    PROVIDER_OPTIONS = %i[
      provider provider_model provider_endpoint provider_trace provider_qualification provider_max_choices
    ].freeze

    def spawn_desktop(socket, target, options)
      if options[:backend] || options[:display] || options[:side]
        return warn("macOS attachment does not accept Safari backend or window-placement options") || USAGE
      end

      target["concurrency"] = options[:cooperative] ? "cooperative" : "exclusive"
      PROVIDER_OPTIONS.each do |key|
        target[key.to_s] = options[key] if options[key]
      end
      spawn_server(socket, target)
      result = observe(options)
      close_failed_desktop_session(options) unless result == OK
      result
    rescue StandardError
      close_failed_desktop_session(options) if File.socket?(socket)
      raise
    end

    def close_failed_desktop_session(options)
      client(options).call("close")
      await_session_shutdown(SessionServer.socket_path(options[:session]), 1)
    rescue Error, SystemCallError
      nil
    end

    def await_session_shutdown(socket, timeout)
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
      while (File.socket?(socket) || File.exist?("#{socket}.pid")) &&
            Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
        sleep 0.01
      end
    end

    # Half a screen is the useful case: a window big enough to render a real page, parked where it is
    # not in the user's way. Resolved here rather than in the session so the geometry is visible in
    # the command that asked for it.
    SIDES = %w[left right top bottom].freeze

    def side_bounds(index, side)
      return warn("Unknown --side #{side.inspect}. Choose #{SIDES.join(", ")}.") && nil unless SIDES.include?(side)

      listed = Wrangle::Safari.displays
      display = listed[index || 0]
      return warn("No display #{index || 0}; #{listed.length} attached.") && nil unless display

      x, y, width, height = display.values_at("x", "y", "width", "height")
      case side
      when "left" then [x, y, width / 2, height]
      when "right" then [x + (width / 2), y, width / 2, height]
      when "top" then [x, y, width, height / 2]
      else [x, y + (height / 2), width, height / 2]
      end
    end

    def spawn_server(socket, target)
      log = File.join(File.dirname(socket), "#{File.basename(socket, ".sock")}.log")
      FileUtils.mkdir_p(File.dirname(socket))
      command = target["driver"] == "macos" ? "__serve_macos" : "__serve"
      pid = Process.spawn(RbConfig.ruby, __FILE__, command, socket, JSON.generate(target),
                          out: log, err: log, pgroup: true)
      Process.detach(pid)
      File.write("#{socket}.pid", "#{pid}\n", mode: "w", perm: 0o600)
      await(socket, log)
    end

    def await(socket, log)
      probe = SessionClient.new(socket)
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 30
      until probe.running?
        if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
          raise Wrangle::Error, "The session did not start. Last output:\n#{tail(log)}"
        end

        sleep 0.1
      end
    end

    def tail(log) = File.exist?(log) ? File.readlines(log).last(12).join : "(no output)"

    def serve(argv)
      SessionServer.run(argv[0], JSON.parse(argv[1]))
      OK
    end

    def serve_macos(argv)
      DesktopSessionServer.run(argv[0], JSON.parse(argv[1]))
      OK
    end

    def observe(options)
      request(options, "observe", settle: options[:settle] || 0.0)
    end

    def drill(ref, options)
      return warn("drill needs an action number from the last observation") || USAGE unless ref&.match?(/\A\d+\z/)

      request(options, "drill", ref: Integer(ref))
    end

    def inspect(options)
      reply = client(options).call("inspect")
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      puts JSON.pretty_generate(reply["value"])
      OK
    end

    def preview(ref, options)
      if options[:goal]
        reply = client(options).call("preview", goal: options[:goal], literals: options[:literals] || {},
                                                min_confidence: options[:min_confidence] || 0.5,
                                                steps: options[:steps] || 8)
        return show_desktop_decision(reply, options)
      end
      return warn("preview needs an action number or --goal") || USAGE unless ref&.match?(/\A\d+\z/)

      reply = client(options).call("preview", ref: Integer(ref), operation: options[:operation], text: options[:text])
      show_desktop_proposal(reply, options)
    end

    def show_desktop_decision(reply, options)
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      decision = reply["value"]
      puts "decision  #{decision["operation"]} (#{(decision["confidence"] * 100).round}% sure)"
      puts "provider  #{decision["provider"]}/#{decision["model"]}"
      puts "paused    #{decision["paused"]}" if decision["paused"]
      return OK unless decision["proposal"]

      show_proposal(decision["proposal"])
      OK
    end

    def show_desktop_proposal(reply, options)
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      show_proposal(reply["value"])
      OK
    end

    def show_proposal(proposal)
      operation = desktop_operation(proposal.dig("action", "operation"))
      puts "ready    #{operation} #{proposal.dig("action", "label").inspect}"
      puts "text     #{proposal.dig("action", "text", "characters")} exact characters" if
        proposal.dig("action", "text")
      puts "changed  nothing — preview only"
      puts "next     wrangle execute #{proposal["proposal_id"]}"
      puts "approval required before this consequential action" if proposal.dig("policy", "consequential")
    end

    def execute(proposal_id, options)
      return warn("execute needs a proposal id") || USAGE if proposal_id.to_s.empty?

      reply = client(options).call("execute", proposal_id:, approve: options[:approve] || false)
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      receipt = reply["value"]
      puts receipt_summary(receipt)
      puts "continue  wrangle continue #{receipt["run_id"]}" if receipt["can_continue"]
      return TERMINAL if receipt["terminal"]
      return STALE if receipt["dispatch"] == "not_delivered"

      receipt["dispatch"] == "refused" ? USAGE : OK
    end

    def continue_run(run_id, options)
      return warn("continue needs a run id") || USAGE if run_id.to_s.empty?

      reply = client(options).call("continue", run_id:)
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      result = reply["value"]
      puts "run       #{result["status"]} (#{result["remaining"]} actions remain)"
      Array(result["receipts"]).each { |receipt| puts receipt_summary(receipt) }
      show_proposal(result["proposal"]) if result["proposal"]
      result["status"] == "terminal" ? TERMINAL : OK
    end

    def act(ref, options)
      return warn("act needs an action number from the last observation") || USAGE unless ref&.match?(/\A\d+\z/)

      request(options, "act", ref: Integer(ref), text: options[:text], settle: options[:settle] || 3.0)
    end

    def status(options)
      reply = client(options).call("status")
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      reply["value"].each { |key, value| puts format("%-14s %s", key, value.inspect) }
      OK
    end

    def stop(options)
      socket = SessionServer.socket_path(options[:session])
      pid_file = "#{socket}.pid"
      pid = Integer(File.read(pid_file), exception: false) if File.file?(pid_file)
      unless pid&.positive?
        return warn("No stoppable wrangle session named #{options[:session].inspect}.") || UNAVAILABLE
      end

      Process.kill("INT", pid) # One signal. An in-flight mutation is never repeated.
      await_session_shutdown(socket, 3)
      puts "session stopped; any in-flight delivery must be treated as unknown"
      OK
    rescue Errno::ESRCH
      FileUtils.rm_f(pid_file)
      FileUtils.rm_f(socket)
      warn("The session had already exited.") || UNAVAILABLE
    end

    def close(options)
      reply = client(options).call("close")
      await_session_shutdown(SessionServer.socket_path(options[:session]), 1)
      return emit(reply) if options[:json]

      if reply.dig("value", "root_preserved")
        puts "control released; the application window remains open"
      else
        puts reply["ok"] ? "session closed" : reply["error"]
      end
      OK
    end

    def text(options)
      reply = client(options).call("text")
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      body = reply["value"]["text"].split("\n")
      body = body.grep(Regexp.new(options[:match], Regexp::IGNORECASE)) if options[:match]
      puts body
      OK
    end

    # `decide` proposes and stops there. `run` loops, and still refuses to touch the page unless the
    # caller says --execute, because a decision loop that acts by default is a decision loop that
    # surprises someone.
    def propose(argv, options, execute:)
      plan = options[:plan] || []
      goal = options[:goal] || (argv.first if plan.empty?) || plan.first
      return warn("#{execute ? "run" : "decide"} needs a goal") || USAGE unless goal

      params = { goal: goal, literals: options[:literals] || {},
                 min_confidence: options[:min_confidence], settle: options[:settle] || 3.0,
                 steady: options[:steady] }
      return steps(options, "decide", params) unless execute
      return warn("run acts on the page. Add --execute to allow it.") || USAGE unless options[:execute]

      steps(options, "run", params.merge(execute: true, steps: options[:steps] || (plan.empty? ? 8 : 8 * plan.size),
                                         plan: plan, leg_steps: options[:leg_steps], expect: options[:expect]))
    end

    def steps(options, op, params)
      reply = client(options).call(op, **params)
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      value = reply["value"]
      list = value["steps"] || [value]
      numbered = list.count { |step| step["operation"] != "GOAL" } > 1
      counter = 0
      list.each do |step|
        counter += 1 unless step["operation"] == "GOAL"
        show_step(step, numbered ? counter : nil)
      end
      return OK if value["proven"].nil?

      puts value["proven"] ? "proven  the page shows #{value["expected"].inspect}" : nil
      return OK if value["proven"]

      warn "unproven  the page never showed #{value["expected"].inspect}"
      STALE
    end

    def show_step(step, number)
      if step["operation"] == "GOAL"
        puts format("\n== %d. %s", step["index"], step["action"])
        return
      end

      mark = if step["executed"] then "did "
             elsif step["operation"] == "HANDOFF" then "ask "
             elsif %w[DONE BLOCKED].include?(step["operation"]) then step["operation"].downcase
             else "would"
             end
      sure = format("%.0f%% sure", step["confidence"] * 100)
      sure += format("/%.0f%% target", step["target_confidence"] * 100) if step["target_confidence"]
      sure += format(", jev %dms", step["decided_in_ms"]) if step["decided_in_ms"]
      sure += format(", step %dms", step["step_ms"]) if step["step_ms"]
      puts format("%s%-5s %-52s (%s)", number ? format("%2d. ", number) : "", mark,
                  step["action"].to_s[0, 52], sure)
      puts format("      typed: %s", step["text"].inspect) if step["text"]
    end

    def request(options, op, **params)
      reply = client(options).call(op, **params)
      return emit(reply) if options[:json]
      return failed(reply, options) unless reply["ok"]

      report(reply["value"], options)
      OK
    end

    # --- output --------------------------------------------------------------------------------

    def report(value, options)
      return desktop_report(value, options) if value["schema"] == "wrangle.observation.v1"

      puts "acted   #{value["kind"]} #{value["executed"].inspect}" if value["executed"]
      puts "page    #{value["title"].to_s[0, 70].inspect}  <#{value["url"]}>"
      puts format("state   %s  scroll %d/%d  %d chars  %d actions", value["fingerprint"],
                  value["scroll"]["y"], value["scroll"]["height"], value["text_chars"],
                  value["actions"].size)
      changes(value["changed"])
      actions(value["actions"], options)
    end

    def desktop_report(value, options)
      puts "window  #{value.dig("scope", "app")}"
      coverage = value["coverage"]
      if value["complete"]
        count = coverage["candidate_count"]
        puts "ready   found #{count} possible #{count == 1 ? "action" : "actions"}"
      else
        puts "more    part of the window needs a closer look before Wrangle can act"
      end
      if value["changed"]
        puts value.dig("changed", "same") ? "changed nothing" : "changed the available actions"
        show_labels("  appeared", value.dig("changed", "appeared"))
        show_labels("  gone", value.dig("changed", "disappeared"))
      end
      desktop_actions(value["candidates"], options)
    end

    def desktop_actions(list, options)
      shown = options[:match] ? list.select { |item| item["label"] =~ /#{Regexp.escape(options[:match])}/i } : list
      limit = options[:all] || options[:match] ? shown.size : 25
      shown.first(limit).each do |item|
        operations = item["operations"].map { |operation| desktop_operation(operation) }.join("/")
        puts format("  %3d  %-20s %-14s %s", item["ref"], operations, item["role"], item["label"].to_s[0, 70])
      end
      puts "  ... #{shown.size - limit} more (--all, or --match RE to filter)" if shown.size > limit
      OK
    end

    def desktop_operation(operation)
      {
        "DRILL" => "look closer", "PRESS" => "press", "SET_TEXT" => "type",
        "CLEAR" => "clear", "TOGGLE" => "toggle", "EXPAND" => "expand", "COLLAPSE" => "collapse"
      }.fetch(operation, operation.to_s.downcase.tr("_", " "))
    end

    def receipt_summary(receipt)
      dispatch = receipt["dispatch"]
      effect = receipt["effect"]
      return "done     the action succeeded and Wrangle verified the result" if
        dispatch == "delivered" && effect == "verified"
      return "done     the app received the action; Wrangle could not verify the result" if dispatch == "delivered"
      return "stopped  the window changed before Wrangle could act; nothing was sent" if dispatch == "not_delivered"
      return "stopped  the app refused the action; nothing changed" if dispatch == "refused"

      "uncertain the action may or may not have happened; do not repeat it"
    end

    def changes(changed)
      return unless changed

      if changed["same_page"]
        puts "changed nothing — the page is byte-identical. Try a different action."
      else
        parts = []
        parts << "url changed" if changed["url_changed"]
        parts << format("text %+d", changed["text_delta"]) unless changed["text_delta"].zero?
        parts << format("scroll %+d", changed["scroll_delta"]) unless changed["scroll_delta"].zero?
        puts "changed #{parts.join(", ")}" unless parts.empty?
      end
      show_labels("  appeared", changed["appeared"])
      show_labels("  gone", changed["disappeared"])
    end

    def show_labels(prefix, labels)
      return if labels.nil? || labels.empty?

      puts "#{prefix}    #{labels.map { |l| l[0, 58].inspect }.join(", ")}"
    end

    def actions(list, options)
      shown = list
      shown = shown.select { |a| a["label"] =~ Regexp.new(options[:match], Regexp::IGNORECASE) } if options[:match]
      limit = options[:all] || options[:match] ? shown.size : 25
      shown.first(limit).each do |action|
        value = action["value"] ? "  = #{action["value"][0, 30].inspect}" : ""
        puts format("  %3d  %-7s %-9s %s%s", action["ref"], action["kind"], action["role"],
                    action["label"][0, 74], value)
      end
      return unless shown.size > limit

      puts "  ... #{shown.size - limit} more (--all, or --match RE to filter)"
    end

    def failed(reply, options)
      warn "#{reply["class"]}: #{reply["error"]}"
      warn "hint: #{reply["hint"]}" if reply["hint"]
      return TERMINAL if reply["terminal"]

      %w[StalePage ArgumentError].include?(reply["class"]) ? STALE : (options && UNAVAILABLE)
    end

    def emit(value)
      puts JSON.pretty_generate(value)
      value.is_a?(Hash) && value["ok"] == false ? STALE : OK
    end
  end
end

exit(Wrangle::CLI.run(ARGV) || Wrangle::CLI::OK)
